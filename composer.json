{
  "name": "the-firehub-project/view",
  "description": "A modular, transport-independent presentation and template rendering subsystem for the FireHub Project ecosystem.",
  "type": "library",
  "keywords": ["php", "framework", "firehub", "presentation", "rendering", "template-engine", "view", "view-model"],
  "homepage": "https://the-firehub-project.github.io/view",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.5",

    "the-firehub-project/core-standard": "dev-develop",
    "the-firehub-project/runtime": ">=0.1.0 <1.0.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "the-firehub-project/phpstan-rules": "dev-develop",

    "the-firehub-project/testing": "dev-develop"
  },
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "FireHub\\View\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FireHub\\Tests\\View\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Danijel Galić",
      "email": "danijel.galic@outlook.com",
      "homepage": "https://github.com/dieselxxx",
      "role": "Owner"
    }
  ],
  "support": {
    "email": "danijel.galic@outlook.com",
    "issues": "https://github.com/The-FireHub-Project/View/issues",
    "forum": "https://github.com/orgs/The-FireHub-Project/discussions",
    "wiki": "https://github.com/The-FireHub-Project/View/wiki",
    "source": "https://github.com/The-FireHub-Project/View",
    "docs": "https://the-firehub-project.github.io/View",
    "security": "https://github.com/The-FireHub-Project/View/security/policy"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/The-FireHub-Project"
    }
  ],
  "config": {
    "prepend-autoloader": false,
    "optimize-autoloader": true,
    "platform-check": true
  },
  "extra": {
    "firehub": {
      "layer": "runtime",
      "edition": "standard",
      "role": "presentation & rendering",
      "criticality": "medium",
      "ci": {
        "php-versions": ["8.5"]
      }
    }
  }
}